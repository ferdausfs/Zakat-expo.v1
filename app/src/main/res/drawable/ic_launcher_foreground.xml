<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="192"
    android:viewportHeight="192">
  <!-- Zakat emblem: diamond formed by interlaced Kufic-style strokes,
       teal-to-green gradient, small diamond accent at the center.
       Geometry lives in the central 192x192 group (scale 0.5, offset 48)
       so the artwork stays inside the adaptive-icon safe zone. -->
  <group android:scaleX="0.5" android:scaleY="0.5" android:translateX="48" android:translateY="48">
    <!-- Outer diamond ring: four Kufic stroke segments with breath gaps -->
    <path
        android:pathData="M91.76,56.24 L56.24,91.76"
        android:strokeWidth="8"
        android:strokeLineCap="butt">
      <aapt:attr name="android:strokeColor">
        <gradient
            android:type="linear"
            android:startX="52" android:startY="52"
            android:endX="140" android:endY="140"
            android:startColor="#2DD4BF" android:endColor="#22C55E" />
      </aapt:attr>
    </path>
    <path
        android:pathData="M100.24,56.24 L135.76,91.76"
        android:strokeWidth="8"
        android:strokeLineCap="butt">
      <aapt:attr name="android:strokeColor">
        <gradient
            android:type="linear"
            android:startX="52" android:startY="52"
            android:endX="140" android:endY="140"
            android:startColor="#2DD4BF" android:endColor="#22C55E" />
      </aapt:attr>
    </path>
    <path
        android:pathData="M135.76,100.24 L100.24,135.76"
        android:strokeWidth="8"
        android:strokeLineCap="butt">
      <aapt:attr name="android:strokeColor">
        <gradient
            android:type="linear"
            android:startX="52" android:startY="52"
            android:endX="140" android:endY="140"
            android:startColor="#2DD4BF" android:endColor="#22C55E" />
      </aapt:attr>
    </path>
    <path
        android:pathData="M91.76,135.76 L56.24,100.24"
        android:strokeWidth="8"
        android:strokeLineCap="butt">
      <aapt:attr name="android:strokeColor">
        <gradient
            android:type="linear"
            android:startX="52" android:startY="52"
            android:endX="140" android:endY="140"
            android:startColor="#2DD4BF" android:endColor="#22C55E" />
      </aapt:attr>
    </path>
    <!-- Inner woven diamond ring -->
    <path
        android:pathData="M96,74 L118,96 L96,118 L74,96 Z"
        android:strokeWidth="4.5"
        android:strokeLineJoin="round">
      <aapt:attr name="android:strokeColor">
        <gradient
            android:type="linear"
            android:startX="74" android:startY="74"
            android:endX="118" android:endY="118"
            android:startColor="#2DD4BF" android:endColor="#22C55E" />
      </aapt:attr>
    </path>
    <!-- Small diamond accent at the center -->
    <path android:pathData="M96,87.5 L104.5,96 L96,104.5 L87.5,96 Z">
      <aapt:attr name="android:fillColor">
        <gradient
            android:type="linear"
            android:startX="87.5" android:startY="87.5"
            android:endX="104.5" android:endY="104.5"
            android:startColor="#5EEAD4" android:endColor="#4ADE80" />
      </aapt:attr>
    </path>
  </group>
</vector>
